{
  "$schema": "https://desirecore.net/schemas/agentfs/v1/agent-config.json",
  "version": "0.1.0",
  "llm": {
    "routingMode": "fixed",
    "smart": {
      "profile": {
        "tier": "flagship",
        "requiredCapabilities": [
          "vision",
          "tool_use"
        ],
        "reasoning": "auto"
      }
    },
    "provider": "desirecore-cloud",
    "providerId": "desirecore-cloud",
    "model": "qwen3.8-max",
    "maxRetryDelayMs": 32000
  },
  "heartbeat": {
    "enabled": false
  },
  "session_mode": {
    "manual": false
  },
  "env": {
    "enabled": true,
    "includeWeekday": true,
    "includeLocalTime": true,
    "includeSessionStart": true,
    "includeOs": true,
    "includeRuntime": true,
    "includeManagedRuntimes": true
  },
  "mcp_servers": {},
  "capabilities": [],
  "trigger_patterns": [],
  "accepts_handoff": true,
  "accepts_messages": true,
  "max_concurrent_sessions": 3,
  "id": "c0d06734-96eb-460f-ab7f-09ab95def314",
  "name": "商务报价审查员",
  "description": "商务报价审查员：金额税额合计、日期、主体、报价口径重算",
  "delegation_input_contract": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "kind",
        "role",
        "target_agent_id",
        "original_request",
        "assignment",
        "task_spec",
        "preflight"
      ],
      "properties": {
        "protocol": {
          "const": "tender-delegation-input/v1"
        },
        "kind": {
          "const": "business"
        },
        "role": {
          "const": "commercial"
        },
        "target_agent_id": {
          "type": "string",
          "minLength": 1,
          "description": "Current verified target; stable semantic role is separate from identity."
        },
        "original_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byte_length",
            "text"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Exact existing authorized path; grants no access."
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Complete original UTF-8 request, read from exact original bytes; never paraphrased."
            }
          }
        },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role_task",
            "io_scope",
            "resources",
            "parent_plan",
            "delivery_requirements"
          ],
          "properties": {
            "role_task": {
              "type": "string",
              "minLength": 1,
              "description": "Bounded role task; does not replace original request."
            },
            "io_scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "read_only_paths",
                "callee_write_paths",
                "lead_write_paths"
              ],
              "properties": {
                "read_only_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Authorized path, not a grant."
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "callee_write_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Authorized path, not a grant."
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "lead_write_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Authorized path, not a grant."
                  },
                  "minItems": 1,
                  "maxItems": 256
                }
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "resource_id",
                  "constraint_ids",
                  "kind",
                  "path",
                  "sha256"
                ],
                "properties": {
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Current binding identity."
                  },
                  "constraint_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Constraint identity."
                    },
                    "minItems": 1,
                    "maxItems": 256
                  },
                  "kind": {
                    "enum": [
                      "installed_skill",
                      "helper",
                      "runtime_executable",
                      "dependency_lock",
                      "input_manifest",
                      "capability_receipt",
                      "contract_schema",
                      "other"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Verified resource path; no grant."
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Actual observed version if applicable."
                  }
                }
              },
              "minItems": 0,
              "maxItems": 256
            },
            "parent_plan": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "revision"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Current authoritative Plan path."
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "delivery_requirements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Required delivery evidence."
              },
              "minItems": 1,
              "maxItems": 256
            }
          }
        },
        "task_spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byte_length",
            "task_id",
            "revision",
            "value"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Exact existing authorized path; grants no access."
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "description": "ID from original Spec."
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "object",
              "required": [
                "spec_version",
                "task_id",
                "revision",
                "purpose",
                "parent_plan",
                "target_agent_id",
                "instruction_sources",
                "hard_constraints",
                "resources",
                "io_scope",
                "acceptance_criteria",
                "failure_policy",
                "delivery_requirements"
              ],
              "properties": {
                "spec_version": {
                  "const": "lead-delegation-task/v1"
                },
                "task_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Spec ID."
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "target_agent_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Actual current target ID."
                },
                "instruction_sources": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "hard_constraints": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "minItems": 0,
                  "maxItems": 256
                },
                "io_scope": {
                  "type": "object"
                },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "delivery_requirements": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Required delivery."
                  },
                  "minItems": 1,
                  "maxItems": 256
                }
              },
              "description": "Full parsed TaskSpec value; shallow structural projection only, not the original schema or semantic verification."
            }
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "byte_length",
            "value",
            "execution_receipt"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Exact existing authorized path; grants no access."
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 262144
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result_version",
                "result",
                "spec_sha256",
                "checks",
                "semantic_completeness",
                "violations",
                "read_file_count",
                "mode",
                "physical_scope_status",
                "file_stability_status",
                "deadline_mode",
                "capture_provenance",
                "capture_check_count"
              ],
              "properties": {
                "result_version": {
                  "const": "lead-task-spec-check/v1"
                },
                "result": {
                  "const": "pass"
                },
                "spec_sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
                },
                "checks": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema",
                    "authority",
                    "runtime_lock",
                    "sources",
                    "references",
                    "scopes",
                    "resources",
                    "stability"
                  ],
                  "properties": {
                    "schema": {
                      "const": true
                    },
                    "authority": {
                      "const": true
                    },
                    "runtime_lock": {
                      "const": true
                    },
                    "sources": {
                      "const": true
                    },
                    "references": {
                      "const": true
                    },
                    "scopes": {
                      "const": true
                    },
                    "resources": {
                      "const": true
                    },
                    "stability": {
                      "const": true
                    }
                  }
                },
                "semantic_completeness": {
                  "const": "not_established"
                },
                "violations": {
                  "type": "array",
                  "maxItems": 0
                },
                "read_file_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "enum": [
                    "file-posix",
                    "inline"
                  ]
                },
                "physical_scope_status": {
                  "enum": [
                    "verified_existing_paths",
                    "not_checked_inline"
                  ]
                },
                "file_stability_status": {
                  "enum": [
                    "verified",
                    "not_checked_inline"
                  ]
                },
                "deadline_mode": {
                  "enum": [
                    "signal",
                    "thread-watchdog"
                  ]
                },
                "capture_provenance": {
                  "enum": [
                    "not_applicable",
                    "caller_supplied_not_authenticated"
                  ]
                },
                "capture_check_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "execution_receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "byte_length"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact existing authorized path; grants no access."
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "description": "Original file byte SHA-256. Shape only; hexadecimal and identity are checked outside this structural gate."
                },
                "byte_length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 262144
                }
              }
            }
          }
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Tender delegation input structural projection v1",
      "description": "Candidate for an unreleased platform interface. Shape does not prove authorization, truthful execution, complete semantics, or successful specialist review. Original TaskSpec/checker remains authoritative."
    }
  }
}